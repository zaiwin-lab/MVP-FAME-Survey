# Partner branding kill-switch.
#
# Leave unset (or "false") until FAME holds written approval from SAIC.
# While it is off, no SAIC name, logo or endorsement appears anywhere in the
# build, and the header shows "Strategic partnership invitation in progress".
#
# Set to "true" only after approval, and add the approved logo asset then.
VITE_SAIC_APPROVED=false
